APP_NAME=
APP_VERSION=0.1.0
# Environment mode: development | staging | production
ENVIRONMENT=development

# Database connection:
# SQLite (development): sqlite:///./edufind.db
# PostgreSQL (staging/production): postgresql+psycopg://username:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./edufind.db

# Storage directory for uploaded PDFs and generated reports (use persistent mount in staging/production, e.g. /var/data/uploads)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=52428800
MIN_EXTRACTABLE_TEXT_CHARS=100

# Allowed CORS origins: comma-separated list of exact frontend URLs (e.g. https://edufind.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=INFO

# Phase 4 research metadata clients (no credentials required by default).
CROSSREF_MAILTO=
OPENALEX_API_KEY=
CROSSREF_API_URL=https://api.crossref.org/v1
OPENALEX_API_URL=https://api.openalex.org
RESEARCH_HTTP_TIMEOUT_SECONDS=8
RESEARCH_RETRY_ATTEMPTS=2

# Phase 5 AI verification (the API key is optional until verification is requested).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
GEMINI_RETRY_ATTEMPTS=2

